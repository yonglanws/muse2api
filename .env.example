# ---- 服务 ----
MUSE2API_HOST=127.0.0.1
MUSE2API_PORT=18610
MUSE2API_LOG_LEVEL=INFO
# 媒体链接使用的公开地址；留空则从请求推导
MUSE2API_PUBLIC_BASE=

# ---- 鉴权 ----
# 留空则自动生成并保存到 data/api_key
MUSE2API_API_KEY=
# 留空则与 API Key 相同
MUSE2API_ADMIN_KEY=

# ---- 存储 ----
MUSE2API_DATA_DIR=data
# /v1/* 请求日志保留天数（data/requests.db，每小时清理）
MUSE2API_REQUEST_LOG_RETENTION_DAYS=14
# 生成媒体保留天数（data/media，每小时清理；0 关闭）
MUSE2API_MEDIA_RETENTION_DAYS=14
# Responses API 对话可被 previous_response_id 续聊的秒数（data/responses.json）
MUSE2API_RESPONSE_TTL=604800
# store=true 的 Chat Completions 保留秒数（data/chat_completions.json，默认 30 天）
MUSE2API_CHAT_STORE_TTL=2592000
# /v1/files 单文件上限（字节）
MUSE2API_FILE_MAX_BYTES=104857600
# 上传文件保留天数（data/files，每小时清理；0 关闭）
MUSE2API_FILES_RETENTION_DAYS=30
# 聊天内生成的图片/视频/文档是否重新托管并追加到回复（网页端能看到，API 端也应该看到）
MUSE2API_CHAT_MEDIA=true
# 聊天内产物下载上限（字节），0 不限制
MUSE2API_CHAT_MEDIA_MAX_BYTES=33554432

# ---- 驱动：mock | protocol | browser | http ----
# protocol：原生 Noise / chat.stream，无需 Chromium（推荐）
# browser：Chromium + CDP，兼容回退
# mock：离线假数据，用于开发
MUSE2API_DRIVER=mock
# 上游地址
MUSE2API_SITE_URL=https://muse.ai

# ---- 协议驱动 ----
# Python 的上游 HTTP / WebSocket 连接使用的代理
MUSE2API_UPSTREAM_PROXY=
# MUSE2API_UPSTREAM_PROXY=http://127.0.0.1:7890
# 协议连接心跳间隔（秒），0 关闭
MUSE2API_PROTOCOL_PING_INTERVAL=30
# 唤醒 VM 后等待 RUNNING 的秒数
MUSE2API_PROTOCOL_WAKE_CONFIRM=20
# 空闲线程保留时间（秒），0 表示永久保留
MUSE2API_PROTOCOL_THREAD_TTL=21600
# 每个账号保留的线程数
MUSE2API_PROTOCOL_MAX_THREADS=64
# 每个账号并行使用的 Noise 连接数；并发请求分摊到多条连接，线程固定在自己的连接上
MUSE2API_PROTOCOL_CONNECTIONS=2

# ---- 浏览器驱动 ----
MUSE2API_CHROMIUM_PATH=
# 持久化浏览器 profile 目录；留空 = data/browser-profile
MUSE2API_BROWSER_PROFILE_DIR=
# 仅浏览器使用的代理；muse.ai 可直连时留空
MUSE2API_BROWSER_PROXY=
# MUSE2API_BROWSER_PROXY=socks5://127.0.0.1:10808
MUSE2API_CDP_PORT=19210
MUSE2API_HEADLESS=true
MUSE2API_PAGE_READY_TIMEOUT=45

# ---- 热线程 ----
# 每个账号预热的线程数：新线程首条回复需要 20-40 秒，已预热约 5 秒。
# 每个热线程会多消耗一条短消息额度；需要并发数 >= 2；0 关闭。
MUSE2API_WARM_THREADS=2

# ---- 超时（秒）----
MUSE2API_CHAT_TIMEOUT=300
MUSE2API_FIRST_TOKEN_TIMEOUT=75
# 等待首个流式 token 时发送 SSE ': keepalive' 注释的间隔；0 关闭
MUSE2API_STREAM_HEARTBEAT_INTERVAL=0
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600

# ---- CORS ----
# 允许从浏览器直接调 /v1/* 的来源（逗号分隔），与 api.openai.com 的
# Access-Control-Allow-Origin: * 一致；/admin/* 仍只对 Cookie 导入插件放行
MUSE2API_CORS_ORIGINS=*

# ---- 账号池 ----
# lru | round_robin | affinity
# affinity 让同一用户固定在同一账号，便于复用热线程
MUSE2API_POOL_STRATEGY=affinity
MUSE2API_POOL_ACQUIRE_TIMEOUT=60
# 每个账号的并行请求数（上游实测 12 条并发流无压力，网关默认与之对齐）
MUSE2API_ACCOUNT_MAX_CONCURRENCY=12
# 上游出错后的账号冷却秒数（超时不计算在内）
MUSE2API_ACCOUNT_COOLDOWN=30
MUSE2API_MAX_FAILOVER=2

# ---- system 提示词与工具调用 ----
# 把 system/developer 消息放进当前用户轮（muse.ai 没有独立的 system 角色）
MUSE2API_MAX_PROMPT_CHARS=18000
# auto：原生客户端命令优先，JSON Planner 兜底；native：只用原生；planner：只用 Planner
MUSE2API_TOOL_CHANNEL=auto
MUSE2API_EMULATE_TOOLS=true
# Planner 被拒绝时的重试次数（每次换新线程）
MUSE2API_TOOL_RETRIES=2
# 协议驱动：在账号 VM 的 IDENTITY.md / SOUL.md / AGENTS.md 里维护一段 muse2api 托管规则，
# 让每个会话真正跟随 system 指令、隔离账号记忆并优先调用已注册客户端命令。
# 原文件会先备份到 data/harness_backup/，可用 POST /admin/harness/{id}/restore 还原。
MUSE2API_NATIVE_HARNESS=true

# ---- 透明背景抠图 ----
# 需要 pip install -e '.[matting]'。birefnet-general 效果最好，-lite 更快
MUSE2API_MATTING_MODEL=birefnet-general

# ---- 会话保活 ----
MUSE2API_KEEPALIVE_ENABLED=true
MUSE2API_KEEPALIVE_INTERVAL=600
